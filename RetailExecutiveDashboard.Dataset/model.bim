        "dataCategory": "Time",
        "lineageTag": "40f9024e-e7cc-4754-bba0-156006ae7d88",
        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "expression": [
                "VAR _MinDate = MIN ( 'Fact Sales'[Order Date] )",
                "VAR _MaxDate = MAX ( 'Fact Sales'[Order Date] )",
                "RETURN",
                "    ADDCOLUMNS (",
                "        CALENDAR ( _MinDate, _MaxDate ),",
                "        \"Year (YYYY)\", YEAR ( ''[Date] ),",
                "        \"Year\", FORMAT ( ''[Date], \"YYYY\" ),",
                "        \"Quarter Year\", \"Q\" & FORMAT ( ''[Date], \"Q YYYY\" ),",
                "        \"Year Quarter\", YEAR ( ''[Date] ) * 100 + QUARTER ( ''[Date] ),",
                "        \"Month Year\", FORMAT ( ''[Date], \"MMM YYYY\" ),",
                "        \"Year Month\", YEAR ( ''[Date] ) * 100 + MONTH ( ''[Date] ),",
                "        \"Month (MMM)\", FORMAT ( ''[Date], \"MMM\" ),",
                "        \"Month (MM)\", MONTH ( ''[Date] ),",
                "        \"Weekday Name\", FORMAT ( ''[Date], \"DDDD\" ),",
                "        \"Weekday Number\", WEEKDAY ( ''[Date], 2 ),",
                "        \"DatesWithSales (True/False)\", ''[Date] <= _MaxDate,",
                "        \"IsThisYear (True/False)\", YEAR ( ''[Date] ) = YEAR ( _MaxDate )",
                "    )"
              ],
              "type": "calculated"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Value",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "isNameInferred": true,
            "lineageTag": "a64587d0-701e-4b18-b5b8-d5349b19409d",
            "sourceColumn": "[Value]",
            "summarizeBy": "sum",
            "type": "calculatedTableColumn"
          }
        ],
        "isHidden": true,
        "lineageTag": "333e17d2-d8c9-4431-9859-d4f7b0ced21d",
        "measures": [
          {
            "name": "Revenue",
            "description": "Net sale-line revenue in GBP. Excludes cancellations, fees, and non-positive quantity or price.",
            "displayFolder": "1. Measures\\Revenue",
            "expression": [
              "ROUND (",
              "    CALCULATE (",
              "        SUM ( 'Fact Sales'[Line Amount] ),",
              "        'Fact Sales'[Is Revenue] = TRUE ()",
              "    ),",
              "    2",
              ")"
            ],
            "formatString": "£#,##0;-£#,##0;£0",
            "lineageTag": "8fda2723-8535-4f26-b8e7-b0490a9631ed"
          },
          {
            "name": "Orders",
            "description": "Distinct sale invoices. Cancellations and fee-only invoices are excluded.",
            "displayFolder": "1. Measures\\Orders",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( 'Fact Sales'[Invoice] ),",
              "    'Fact Sales'[Is Revenue] = TRUE ()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "99f54ef8-fdb7-4eb6-80a1-5cf547f7f654"
          },
          {
            "name": "Customers",
            "description": "Distinct identified customers on sale lines. Guests are excluded.",
            "displayFolder": "1. Measures\\Customers",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( 'Fact Sales'[Customer ID] ),",
              "    'Fact Sales'[Is Revenue] = TRUE (),",
              "    'Fact Sales'[Is Guest] = FALSE ()",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "be682969-ddcd-4c9d-a32c-abddbc38ac99"
          },
          {
            "name": "Order Value (Avg)",
            "description": "Average order value: Revenue / Orders.",
            "displayFolder": "1. Measures\\AOV",
            "expression": [
              "DIVIDE (",
              "    [Revenue],",
              "    [Orders]",
              ")"
            ],
            "formatString": "£#,##0.00;£#,##0.00;£0.00",
            "lineageTag": "3c0fddff-5474-4957-bdba-504eb179b3e2"
          },
          {
            "name": "Revenue (CY YTD)",
            "displayFolder": "1. Measures\\Revenue\\YTD",
            "expression": [
              "CALCULATE (",
              "    [Revenue],",
              "    DATESYTD ( 'Date'[Date] )",
              ")"
            ],
            "formatString": "£#,##0;£#,##0;£0",
            "lineageTag": "ae2d2983-ea85-4895-8a10-de33ec10d559"
          },
          {
            "name": "Revenue (PY)",
            "displayFolder": "1. Measures\\Revenue",
            "expression": [
              "CALCULATE (",
              "    [Revenue],",
              "    SAMEPERIODLASTYEAR ( 'Date'[Date] )",
              ")"
            ],
            "formatString": "£#,##0;£#,##0;£0",
            "lineageTag": "ebc51c6f-1bc6-4c11-bf5d-c92fc85562e4"
          },
          {
            "name": "Revenue (PY YTD)",
            "displayFolder": "1. Measures\\Revenue\\YTD",
            "expression": [
              "CALCULATE (",
              "    [Revenue],",
              "    SAMEPERIODLASTYEAR ( DATESYTD ( 'Date'[Date] ) )",
              ")"
            ],
            "formatString": "£#,##0;£#,##0;£0",
            "lineageTag": "01f3222a-b9b8-43ed-9170-3a2537a32b76"
          },
          {
            "name": "Revenue (Δ PY)",
            "displayFolder": "1. Measures\\Revenue\\vs. PY",
            "expression": [
              "VAR _CY = [Revenue]",
              "VAR _PY = [Revenue (PY)]",
              "RETURN",
              "    _CY - _PY"
            ],
            "formatString": "+£#,##0;-£#,##0;£0",
            "lineageTag": "c95124a5-279d-426b-9bc3-9c0b3867f9a9"
          },
          {
            "name": "Revenue (Δ% PY)",
            "displayFolder": "1. Measures\\Revenue\\vs. PY",
            "expression": [
              "DIVIDE (",
              "    [Revenue (Δ PY)],",
              "    [Revenue (PY)]",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "0ef786ec-62a0-4968-85df-ac5dddc1b60e"
          },
