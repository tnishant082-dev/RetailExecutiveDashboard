    "expressions": [
      {
        "name": "pOnlineRetailPath",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ],
        "expression": "\"E:\\DS-Command-Cente\\powerbi\\RetailExecutiveDashboard\\data\\online_retail_II.xlsx\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "kind": "m",
        "lineageTag": "3db59e93-b143-4547-8486-1b7dbdf69970"
      },
      {
        "name": "Online Retail Combined",
        "expression": [
          "let",
          "    Source = Excel.Workbook(File.Contents(pOnlineRetailPath), null, true),",
          "    Sheet0910 = Source{[Item=\"Year 2009-2010\", Kind=\"Sheet\"]}[Data],",
          "    Sheet1011 = Source{[Item=\"Year 2010-2011\", Kind=\"Sheet\"]}[Data],",
          "    Promote0910 = Table.PromoteHeaders(Sheet0910, [PromoteAllScalars=true]),",
          "    Promote1011 = Table.PromoteHeaders(Sheet1011, [PromoteAllScalars=true]),",
          "    Combined = Table.Combine({Promote0910, Promote1011}),",
          "    Typed = Table.TransformColumns(",
          "        Combined,",
          "        {",
          "            {\"Invoice\", each if _ = null then null else Text.Trim(Text.From(_)), type text},",
          "            {\"StockCode\", each if _ = null then null else Text.Trim(Text.From(_)), type text},",
          "            {\"Description\", each if _ = null then \"Unknown Product\" else Text.Trim(Text.From(_)), type text},",
          "            {\"Quantity\", each try Int64.From(_) otherwise null, Int64.Type},",
          "            {\"InvoiceDate\", each try DateTime.From(_) otherwise null, type datetime},",
          "            {\"Price\", each try Number.From(_) otherwise null, type number},",
          "            {\"Customer ID\", each if _ = null then null else try Text.From(Int64.From(_)) otherwise Text.Trim(Text.From(_)), type text},",
          "            {\"Country\", each if _ = null then \"Unknown\" else Text.Trim(Text.From(_)), type text}",
          "        }",
          "    ),",
          "    Filtered = Table.SelectRows(",
          "        Typed,",
          "        each [Invoice] <> null and [Invoice] <> \"\"",
          "            and [StockCode] <> null and [StockCode] <> \"\"",
          "            and [InvoiceDate] <> null",
          "            and [Quantity] <> null",
          "            and [Price] <> null",
          "    ),",
          "    Deduped = Table.Distinct(",
          "        Filtered,",
          "        {\"Invoice\", \"StockCode\", \"InvoiceDate\", \"Quantity\", \"Price\", \"Customer ID\", \"Country\"}",
          "    ),",
          "    FeeCodes = {\"POST\", \"DOT\", \"AMAZONFEE\", \"BANK CHARGES\", \"PADS\", \"CRUK\"},",
          "    WithFlags = Table.AddColumn(",
          "        Deduped,",
          "        \"Is Cancel\",",
          "        each Text.StartsWith([Invoice], \"C\"),",
          "        type logical",
          "    ),",
          "    WithFee = Table.AddColumn(",
          "        WithFlags,",
          "        \"Is Fee\",",
          "        each List.Contains(FeeCodes, Text.Upper([StockCode])),",
          "        type logical",
          "    ),",
          "    WithRevenue = Table.AddColumn(",
          "        WithFee,",
          "        \"Is Revenue\",",
          "        each [Is Cancel] = false and [Is Fee] = false and [Quantity] > 0 and [Price] > 0,",
          "        type logical",
          "    ),",
          "    WithGuest = Table.AddColumn(",
          "        WithRevenue,",
          "        \"Is Guest\",",
          "        each [Customer ID] = null,",
          "        type logical",
          "    ),",
          "    WithAmount = Table.AddColumn(",
          "        WithGuest,",
          "        \"Line Amount\",",
          "        each Number.Round ( [Quantity] * [Price], 2 ),",
          "        type number",
          "    ),",
          "    WithDate = Table.AddColumn(",
          "        WithAmount,",
          "        \"Order Date\",",
          "        each Date.From([InvoiceDate]),",
          "        type date",
          "    )",
          "in",
          "    WithDate"
        ],
        "kind": "m",
        "lineageTag": "06950667-3fe1-4f0f-88f9-cc00be4cfa33"
      }
    ],
    "relationships": [
