            "lineageTag": "cbeabd8f-bc4a-410e-8333-b438f8c55445"
          },
          {
            "name": "Order Value (Avg) (Δ% PY YTD)",
            "displayFolder": "1. Measures\\AOV\\YTD\\vs. PY",
            "expression": [
              "DIVIDE (",
              "    [Order Value (Avg) (Δ PY YTD)],",
              "    [Order Value (Avg) (PY YTD)]",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "0dad0a28-2aab-47da-80ad-3838ac7ef832"
          },
          {
            "name": "Zero",
            "displayFolder": "2. Report-Specific Objects\\Axis",
            "expression": "0",
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "6f334bf4-dda1-46ba-ba95-3b4cf6913dfd"
          },
          {
            "name": "Selected Measure Name",
            "displayFolder": "2. Report-Specific Objects\\Titles",
            "expression": [
              "VAR _Selected =",
              "    MAX ( 'FP - Selected Measure'[Selected Measure] )",
              "RETURN",
              "    IF ( ISBLANK ( _Selected ), \"Revenue\", _Selected )"
            ],
            "isHidden": true,
            "lineageTag": "ef0b37f2-0a93-4cab-89cd-1f08af911616"
          },
          {
            "name": "Selected Metric",
            "displayFolder": "1. Measures",
            "expression": [
              "VAR _Value =",
              "    SWITCH (",
              "        [Selected Measure Name],",
              "        \"Revenue\", [Revenue],",
              "        \"Orders\", [Orders],",
              "        \"Customers\", [Customers],",
              "        \"Order Value (Avg)\", [Order Value (Avg)],",
              "        [Revenue]",
              "    )",
              "RETURN",
              "    IF (",
              "        [Selected Measure Name] IN { \"Orders\", \"Customers\" },",
              "        ROUND ( _Value, 0 ),",
              "        ROUND ( _Value, 2 )",
              "    )"
            ],
            "formatStringDefinition": {
              "expression": [
                "SWITCH (",
                "    [Selected Measure Name],",
                "    \"Revenue\", \"£#,##0;-£#,##0;£0\",",
                "    \"Orders\", \"#,##0\",",
                "    \"Customers\", \"#,##0\",",
                "    \"Order Value (Avg)\", \"£#,##0.00;£#,##0.00;£0.00\",",
                "    \"£#,##0;-£#,##0;£0\"",
                ")"
              ]
            },
            "lineageTag": "a7c4e91d-3b58-4f02-9e6a-1d8c5b7f2403"
          },
          {
            "name": "Selected Measure (Latest Point)",
            "description": "Value of the field-parameter metric on the latest month in selection. Blank on other months so the line chart can label the last point.",
            "displayFolder": "2. Report-Specific Objects\\Trend",
            "expression": [
              "VAR _LatestDate =",
              "    CALCULATE (",
              "        MAX ( 'Date'[Date] ),",
              "        ALLSELECTED ( 'Date' )",
              "    )",
              "VAR _LatestYM = YEAR ( _LatestDate ) * 100 + MONTH ( _LatestDate )",
              "VAR _ThisYM =",
              "    MAX ( 'Date'[Year Month] )",
              "RETURN",
              "    IF ( _ThisYM = _LatestYM, [Selected Metric], BLANK () )"
            ],
            "isHidden": true,
            "lineageTag": "d0dd534b-dc67-43f5-9dde-af75ea01e361"
          },
          {
            "name": "110% of Highest Selected Measure",
            "displayFolder": "2. Report-Specific Objects\\Axis",
            "expression": "1.1 * MAXX ( ALLSELECTED ( 'Date'[Month Year] ), [Selected Metric] )",
            "isHidden": true,
            "lineageTag": "c1b4d8d8-9155-4926-b1f0-01aebb1a3028"
          },
          {
            "name": "Title - Page",
            "displayFolder": "2. Report-Specific Objects\\Titles",
            "expression": [
              "VAR _MinDate = MIN ( 'Date'[Date] )",
              "VAR _MaxDate = MAX ( 'Date'[Date] )",
              "VAR _Period =",
              "    FORMAT ( _MinDate, \"MMM YYYY\" ) & \" – \" & FORMAT ( _MaxDate, \"MMM YYYY\" )",
              "RETURN",
              "    \"Retail Performance  ·  \" & _Period"
            ],
            "isHidden": true,
            "lineageTag": "0e1b9b5a-f114-417b-aa4b-b408b0641998"
          },
          {
            "name": "Title - Trend",
            "displayFolder": "2. Report-Specific Objects\\Titles",
            "expression": "[Selected Measure Name] & \" Trend\"",
            "isHidden": true,
            "lineageTag": "04f2a63e-d760-4a99-b3d7-fb81ce38dad3"
          },
          {
            "name": "Title - Products",
            "displayFolder": "2. Report-Specific Objects\\Titles",
            "expression": "\"Top Products by \" & [Selected Measure Name]",
            "isHidden": true,
            "lineageTag": "db845829-ceef-400a-b2a6-200eb7857d86"
          },
          {
            "name": "Title - Countries",
            "displayFolder": "2. Report-Specific Objects\\Titles",
            "expression": "\"Top Countries by \" & [Selected Measure Name]",
            "isHidden": true,
            "lineageTag": "67acfd33-7130-4bcf-8652-7925c6ee0785"
          },
          {
            "name": "Subtitle - Revenue",
            "displayFolder": "2. Report-Specific Objects\\Titles",
            "expression": [
              "VAR _Delta = [Revenue (Δ% PY)]",
              "RETURN",
              "    \"vs LY  \" & FORMAT ( _Delta, \"▲ #,##0.0%;▼ #,##0.0%;0.0%\" )"
            ],
            "isHidden": true,
            "lineageTag": "8c208427-d818-4040-8765-40cb7aeecdab"
          },
          {
            "name": "Subtitle - Orders",
            "displayFolder": "2. Report-Specific Objects\\Titles",
            "expression": [
              "VAR _Delta = [Orders (Δ% PY)]",
              "RETURN",
              "    \"vs LY  \" & FORMAT ( _Delta, \"▲ #,##0.0%;▼ #,##0.0%;0.0%\" )"
            ],
            "isHidden": true,
            "lineageTag": "a38d7e50-4ae6-4abe-a4b4-1a38038f1302"
          },
          {
            "name": "Subtitle - Customers",
            "displayFolder": "2. Report-Specific Objects\\Titles",
            "expression": [
              "VAR _Delta = [Customers (Δ% PY)]",
              "RETURN",
              "    \"vs LY  \" & FORMAT ( _Delta, \"▲ #,##0.0%;▼ #,##0.0%;0.0%\" )"
            ],
            "isHidden": true,
            "lineageTag": "3c9b3f66-8388-42a3-930a-4531ebe418a3"
          },
          {
            "name": "Subtitle - AOV",
            "displayFolder": "2. Report-Specific Objects\\Titles",
            "expression": [
              "VAR _Delta = [Order Value (Avg) (Δ% PY)]",
              "RETURN",
              "    \"vs LY  \" & FORMAT ( _Delta, \"▲ #,##0.0%;▼ #,##0.0%;0.0%\" )"
            ],
            "isHidden": true,
            "lineageTag": "a609801b-723f-4e39-8c33-18dcb67432c4"
          },
          {
            "name": "Color - KPI Variance",
            "displayFolder": "2. Report-Specific Objects\\Colours",
            "expression": [
              "VAR _Delta = [Revenue (Δ% PY)]",
              "RETURN",
              "    IF ( _Delta >= 0, \"#74afcc\", \"#c56161\" )"
            ],
            "isHidden": true,
            "lineageTag": "f32de68b-6aeb-4e8f-a1b0-4a79cb97e529"
          }
        ],
