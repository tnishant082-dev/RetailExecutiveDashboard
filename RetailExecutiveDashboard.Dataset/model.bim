        "lineageTag": "562c021d-12ce-481c-bd93-223ff4b50981",
        "partitions": [
          {
            "name": "Fact Sales",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #\"Online Retail Combined\",",
                "    WithCustomer = Table.AddColumn(",
                "        Source,",
                "        \"Customer ID Key\",",
                "        each if [Customer ID] = null then \"GUEST\" else [Customer ID],",
                "        type text",
                "    ),",
                "    Renamed = Table.RenameColumns(",
                "        WithCustomer,",
                "        {",
                "            {\"StockCode\", \"Stock Code\"},",
                "            {\"Description\", \"Product Name\"},",
                "            {\"InvoiceDate\", \"Invoice Date\"},",
                "            {\"Price\", \"Unit Price\"}",
                "        }",
                "    ),",
                "    Normalized = Table.TransformColumns(",
                "        Renamed,",
                "        {",
                "            {\"Stock Code\", each Text.Upper(Text.Trim(_)), type text},",
                "            {\"Product Name\", each Text.Trim(_), type text}",
                "        }",
                "    ),",
                "    Merged = Table.NestedJoin(",
                "        Normalized,",
                "        {\"Stock Code\", \"Product Name\"},",
                "        #\"Dim Product\",",
                "        {\"Stock Code\", \"Product Name\"},",
                "        \"Dim Product\",",
                "        JoinKind.LeftOuter",
                "    ),",
                "    Expanded = Table.ExpandTableColumn(",
                "        Merged,",
                "        \"Dim Product\",",
                "        {\"Product Key\"},",
                "        {\"Product Key\"}",
                "    ),",
                "    Removed = Table.RemoveColumns(Expanded, {\"Customer ID\", \"Is Fee\", \"Product Name\"}),",
                "    RenamedCustomer = Table.RenameColumns(Removed, {{\"Customer ID Key\", \"Customer ID\"}}),",
                "    TypedKey = Table.TransformColumnTypes(RenamedCustomer, {{\"Product Key\", Int64.Type}}),",
                "    Indexed = Table.AddIndexColumn(TypedKey, \"Sales Line Key\", 1, 1, Int64.Type),",
                "    Reordered = Table.ReorderColumns(",
                "        Indexed,",
                "        {",
                "            \"Sales Line Key\", \"Product Key\", \"Invoice\", \"Stock Code\", \"Customer ID\", \"Country\",",
                "            \"Invoice Date\", \"Order Date\", \"Quantity\", \"Unit Price\", \"Line Amount\",",
                "            \"Is Cancel\", \"Is Revenue\", \"Is Guest\"",
                "        }",
                "    )",
                "in",
                "    Reordered"
              ],
              "type": "m"
            }
          }
        ]
      },
