            ],
            "dataType": "string",
            "lineageTag": "3831d2c1-2800-40a5-806b-4a55a567d6e1",
            "sourceColumn": "Country",
            "summarizeBy": "none"
          },
          {
            "name": "Region Group",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "1feb43c5-8bde-4e7e-a17c-9e15c114196d",
            "sourceColumn": "Region Group",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "c1d39090-71f0-412d-a08c-d576d77856a8",
        "partitions": [
          {
            "name": "Dim Geography",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #\"Online Retail Combined\",",
                "    Countries = Table.Distinct(Table.SelectColumns(Source, {\"Country\"})),",
                "    Europe = {",
                "        \"EIRE\", \"France\", \"Germany\", \"Netherlands\", \"Belgium\", \"Switzerland\",",
                "        \"Spain\", \"Portugal\", \"Italy\", \"Channel Islands\", \"Finland\", \"Sweden\",",
                "        \"Norway\", \"Denmark\", \"Austria\", \"Poland\", \"Greece\", \"Cyprus\", \"Iceland\",",
                "        \"Malta\", \"Lithuania\", \"Czech Republic\", \"European Community\"",
                "    },",
                "    NorthAmerica = {\"USA\", \"Canada\", \"United States\"},",
                "    AsiaPacific = {\"Australia\", \"Japan\", \"Singapore\", \"Hong Kong\", \"RSA\"},",
                "    WithRegion = Table.AddColumn(",
                "        Countries,",
                "        \"Region Group\",",
                "        each",
                "            if [Country] = \"United Kingdom\" then \"United Kingdom\"",
                "            else if List.Contains(Europe, [Country]) then \"Europe\"",
                "            else if List.Contains(NorthAmerica, [Country]) then \"North America\"",
                "            else if List.Contains(AsiaPacific, [Country]) then \"Asia Pacific\"",
                "            else \"Other\",",
                "        type text",
                "    ),",
                "    Sorted = Table.Sort(WithRegion, {{\"Country\", Order.Ascending}})",
                "in",
                "    Sorted"
              ],
              "type": "m"
            }
          }
        ]
