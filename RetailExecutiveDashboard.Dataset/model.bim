        "lineageTag": "69141fc5-8e8b-48a3-8fa3-0c071aa1033c",
        "partitions": [
          {
            "name": "Dim Product",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #\"Online Retail Combined\",",
                "    Selected = Table.SelectColumns(Source, {\"StockCode\", \"Description\"}),",
                "    Renamed = Table.RenameColumns(",
                "        Selected,",
                "        {{\"StockCode\", \"Stock Code\"}, {\"Description\", \"Product Name\"}}",
                "    ),",
                "    Normalized = Table.TransformColumns(",
                "        Renamed,",
                "        {",
                "            {\"Stock Code\", each Text.Upper(Text.Trim(_)), type text},",
                "            {\"Product Name\", each Text.Trim(_), type text}",
                "        }",
                "    ),",
                "    Deduped = Table.Distinct(Normalized, {\"Stock Code\", \"Product Name\"}),",
                "    Sorted = Table.Sort(",
                "        Deduped,",
                "        {{\"Stock Code\", Order.Ascending}, {\"Product Name\", Order.Ascending}}",
                "    ),",
                "    WithKey = Table.AddIndexColumn(Sorted, \"Product Key\", 1, 1, Int64.Type),",
                "    Reordered = Table.ReorderColumns(",
                "        WithKey,",
                "        {\"Product Key\", \"Stock Code\", \"Product Name\"}",
                "    )",
                "in",
                "    Reordered"
              ],
              "type": "m"
            }
          }
        ]
      },
