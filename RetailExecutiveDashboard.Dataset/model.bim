        "lineageTag": "c118bd0e-9e14-4985-ad5c-25b5a2f0bb94",
        "partitions": [
          {
            "name": "Dim Customer",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #\"Online Retail Combined\",",
                "    WithKey = Table.AddColumn(",
                "        Source,",
                "        \"Customer ID Key\",",
                "        each if [Customer ID] = null then \"GUEST\" else [Customer ID],",
                "        type text",
                "    ),",
                "    Grouped = Table.Group(",
                "        WithKey,",
                "        {\"Customer ID Key\"},",
                "        {",
                "            {\"Is Guest\", each List.Min(List.Transform([Is Guest], each if _ = true then 1 else 0)) = 1, type logical},",
                "            {\"Country First\", each List.First(List.RemoveNulls([Country])), type text},",
                "            {\"First Invoice Date\", each List.Min([Order Date]), type date},",
                "            {\"Last Invoice Date\", each List.Max([Order Date]), type date}",
                "        }",
                "    ),",
                "    Renamed = Table.RenameColumns(Grouped, {{\"Customer ID Key\", \"Customer ID\"}}),",
                "    Sorted = Table.Sort(Renamed, {{\"Customer ID\", Order.Ascending}})",
                "in",
                "    Sorted"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Dim Geography",
        "annotations": [
